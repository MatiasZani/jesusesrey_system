---
import { figures } from '../data/figures';
import FigureAvatar from './FigureAvatar.astro';
const loop = [...figures, ...figures];
---
<div class="fc" id="fc">
  <button class="nav prev" aria-label="Anterior" type="button">‹</button>
  <div class="viewport">
    <div class="track" tabindex="0" aria-label="Personas de fe">
      {loop.map((f, i) => (
        <article class="fig" aria-hidden={i >= figures.length ? 'true' : undefined}>
          <FigureAvatar f={f} />
          <h3>{f.name}</h3>
          <span class="role">{f.role}</span>
          <p>{f.desc}</p>
        </article>
      ))}
    </div>
  </div>
  <button class="nav next" aria-label="Siguiente" type="button">›</button>
</div>

<style>
  .fc { position: relative; }
  .viewport { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .track { display: flex; gap: 1.2rem; overflow-x: auto; padding: .8rem .4rem 1.6rem; scrollbar-width: none; outline: none; text-align: center; touch-action: pan-x pan-y; cursor: grab; }
  .track::-webkit-scrollbar { display: none; }
  .track.drag { cursor: grabbing; user-select: none; }
  .fig { flex: 0 0 270px; background: #fff; border-radius: var(--radius); padding: 1.4rem 1.2rem 1.6rem; box-shadow: 0 12px 34px -18px rgba(26,120,184,.45); border: 1px solid rgba(26,120,184,.12); transition: transform .35s ease, box-shadow .35s; }
  .fig:hover { transform: translateY(-6px); box-shadow: 0 22px 46px -18px rgba(26,120,184,.5); }
  .fig :global(svg) { width: 150px; height: auto; margin: 0 auto .4rem; display: block; }
  .fig h3 { margin: 0; font-size: 1.7rem; }
  .role { display: block; color: var(--night); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; font-weight: 600; margin: .15rem 0 .6rem; }
  .fig p { margin: 0; color: var(--muted); font-size: .95rem; }
  .nav { position: absolute; top: 42%; z-index: 2; width: 46px; height: 46px; border-radius: 50%; border: 0; cursor: pointer; background: var(--night); color: #fff; font-size: 1.7rem; line-height: 1; box-shadow: 0 8px 22px -8px rgba(0,0,0,.4); transition: transform .2s, background .2s; }
  .nav:hover { background: var(--night-2); transform: scale(1.08); }
  .prev { left: -14px; }
  .next { right: -14px; }
  @media (max-width: 640px) { .prev { left: -6px; } .next { right: -6px; } .nav { width: 40px; height: 40px; } .fig { flex-basis: 240px; } }
</style>

<script>
  const root = document.getElementById('fc')!;
  const track = root.querySelector<HTMLElement>('.track')!;
  const SPEED = 38; // px/s
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let pos = 0, kick = 0, last = performance.now(), idleUntil = 0, hover = false, dragging = false, lastSet = 0;

  const half = () => track.scrollWidth / 2 + 9.6; // half of the doubled list incl. the gap
  const wrap = () => { const h = half(); if (pos >= h) pos -= h; else if (pos < 0) pos += h; };
  const step = () => track.querySelector<HTMLElement>('.fig')!.offsetWidth + 19.2;
  const pause = (ms = 1800) => { idleUntil = performance.now() + ms; };

  const frame = (now: number) => {
    const dt = Math.min(0.05, (now - last) / 1000); last = now;
    // user scrolled/swiped natively -> adopt that position
    if (Math.abs(track.scrollLeft - lastSet) > 1.5) { pos = track.scrollLeft; pause(); }
    if (kick) { const d = kick * 0.12; pos += d; kick -= d; if (Math.abs(kick) < 0.5) { pos += kick; kick = 0; } }
    else if (!reduce && !hover && !dragging && now > idleUntil) pos += SPEED * dt;
    wrap();
    track.scrollLeft = pos; lastSet = track.scrollLeft;
    requestAnimationFrame(frame);
  };
  requestAnimationFrame(frame);

  const nudge = (dir: number) => { kick += dir * step(); pause(); };
  root.querySelector('.prev')!.addEventListener('click', () => nudge(-1));
  root.querySelector('.next')!.addEventListener('click', () => nudge(1));
  track.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') nudge(1); if (e.key === 'ArrowLeft') nudge(-1); });
  root.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') hover = true; });
  root.addEventListener('pointerleave', () => { hover = false; });

  // mouse drag (touch uses native scrolling)
  let startX = 0, startPos = 0;
  track.addEventListener('pointerdown', (e) => {
    if (e.pointerType !== 'mouse') return;
    dragging = true; startX = e.clientX; startPos = pos; track.classList.add('drag'); track.setPointerCapture(e.pointerId);
  });
  track.addEventListener('pointermove', (e) => { if (dragging) { pos = startPos - (e.clientX - startX); } });
  const end = () => { dragging = false; track.classList.remove('drag'); pause(); };
  track.addEventListener('pointerup', end); track.addEventListener('pointercancel', end);
</script>
