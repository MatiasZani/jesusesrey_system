---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
---
<footer>
  <div class="container top">
    <div>
      <div class="brand"><Logo size={96} /></div>
      <p class="muted">{site.tagline}.<br />{site.city}</p>
      <p class="verse">“{site.verse.text}”<br /><strong>{site.verse.ref}</strong></p>
    </div>
    <div>
      <h4>Explorar</h4>
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <h4>Contacto</h4>
      <ul>
        <li>{site.address}</li>
        <li><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>
          <a href={site.social.instagram}>Instagram</a> · <a href={site.social.facebook}>Facebook</a> · <a href={site.social.youtube}>YouTube</a>
        </li>
      </ul>
    </div>
  </div>
  <div class="container copy">
    <span>© {new Date().getFullYear()} {site.name}. Todo para la gloria de Dios.</span>
    <span>Desarrollado por <a href="https://www.linkedin.com/in/matias-manzanzani/" target="_blank" rel="noopener noreferrer">Matias Manzanzani</a></span>
  </div>
</footer>

<style>
  footer { background: var(--night); color: #eaf6ff; padding: 4rem 0 2rem; border-top: 1px solid rgba(242,199,92,.3); }
  .top { display: grid; gap: 2.5rem; grid-template-columns: 1.6fr 1fr 1.2fr; }
  .brand { display: flex; align-items: center; gap: .7rem; font-family: var(--font-display); font-size: 1.7rem; color: #fff; margin-bottom: .8rem; }
  .muted { color: #d4ecfb; }
  .verse { font-family: var(--font-display); font-style: italic; font-size: 1.15rem; color: var(--gold-soft); max-width: 38ch; }
  h4 { color: var(--gold); letter-spacing: .15em; text-transform: uppercase; font-size: .8rem; margin: 0 0 1rem; font-family: var(--font-body); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  a { text-decoration: none; color: #eaf6ff; }
  a:hover { color: var(--gold); }
  .copy { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,.1); font-size: .85rem; color: #d4ecfb;
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1.5rem; }
  .copy a { color: var(--gold); }
  .copy a:hover { color: var(--gold-soft); text-decoration: underline; }
  @media (max-width: 800px) { .top { grid-template-columns: 1fr; } }
</style>
