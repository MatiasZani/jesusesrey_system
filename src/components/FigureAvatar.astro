---
import type { Figure } from '../data/figures';
const { f } = Astro.props as { f: Figure };

// ---- colour helpers ----
const clamp = (n: number) => Math.max(0, Math.min(255, Math.round(n)));
const mix = (h: string, t: number, c: number) =>
  '#' + [1, 3, 5].map((i) => clamp(parseInt(h.slice(i, i + 2), 16) * (1 - t) + c * t).toString(16).padStart(2, '0')).join('');
const lt = (h: string, t: number) => mix(h, t, 255);
const dk = (h: string, t: number) => mix(h, t, 0);

// unique id prefix per figure (many copies of the same figure are on the page)
const p = 'fa' + f.name.normalize('NFD').replace(/[^A-Za-z]/g, '').toLowerCase();
const u = (s: string) => `url(#${p}${s})`;

const skin = f.skin, skinD = dk(skin, 0.16), skinS = dk(skin, 0.34), skinL = lt(skin, 0.2);
const robe = f.robe, robeL = lt(robe, 0.2), robeD = dk(robe, 0.22);
const mant = f.mantle ?? dk(robe, 0.3), mantL = lt(mant, 0.22), mantD = dk(mant, 0.25);
const hair = f.hair, hairL = lt(hair, 0.22), hairD = dk(hair, 0.3);
const sash = f.sash ?? '#c9953a', sashD = dk(sash, 0.3);
const acc = f.accessories ?? [];
const fem = !!f.female;
const elder = f.age === 'elder';
const isCoat = f.item === 'coat';
const browC = elder ? dk(hair, 0.45) : hairD;
const bodyFill = isCoat ? u('pat') : u('r');

const star = (cx: number, cy: number, r: number) => {
  const pts: string[] = [];
  for (let i = 0; i < 10; i++) {
    const a = -Math.PI / 2 + (i * Math.PI) / 5, rr = i % 2 ? r * 0.45 : r;
    pts.push((cx + rr * Math.cos(a)).toFixed(1) + ',' + (cy + rr * Math.sin(a)).toFixed(1));
  }
  return `<circle cx="${cx}" cy="${cy}" r="${r * 1.9}" fill="#ffe9a0" opacity=".28"/><polygon points="${pts.join(' ')}" fill="${u('g')}" stroke="#b8862b" stroke-width=".4" stroke-linejoin="round"/>`;
};

// ---- defs ----
const stripes = ['#d9534f', '#3b9fdc', '#f2c75c', '#4f9d69', '#8a4fb5', '#f08a3c'];
const defs = `<defs>
<linearGradient id="${p}r" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${robeL}"/><stop offset="1" stop-color="${robeD}"/></linearGradient>
<linearGradient id="${p}m" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${mantL}"/><stop offset="1" stop-color="${mantD}"/></linearGradient>
<linearGradient id="${p}s" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${skinL}"/><stop offset="1" stop-color="${skin}"/></linearGradient>
<linearGradient id="${p}h" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${hairL}"/><stop offset="1" stop-color="${hairD}"/></linearGradient>
<linearGradient id="${p}g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fbe39a"/><stop offset="1" stop-color="#c9953a"/></linearGradient>
<linearGradient id="${p}w" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#b98350"/><stop offset=".5" stop-color="#8b5e34"/><stop offset="1" stop-color="#6a4524"/></linearGradient>
<linearGradient id="${p}pa" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#e4d3a6"/><stop offset=".5" stop-color="#f7edcf"/><stop offset="1" stop-color="#e4d3a6"/></linearGradient>
<linearGradient id="${p}sh" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#000" stop-opacity=".16"/><stop offset=".45" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".2"/></linearGradient>
<radialGradient id="${p}glow"><stop offset="0" stop-color="#ffd86b" stop-opacity=".85"/><stop offset="1" stop-color="#ffd86b" stop-opacity="0"/></radialGradient>
<linearGradient id="${p}fl" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#e8420f"/><stop offset=".6" stop-color="#ff8c1a"/><stop offset="1" stop-color="#ffc83d"/></linearGradient>
<linearGradient id="${p}ht" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff8aa3"/><stop offset="1" stop-color="#d4284f"/></linearGradient>
<pattern id="${p}pat" width="24" height="10" patternUnits="userSpaceOnUse">${stripes.map((c, i) => `<rect x="${i * 4}" width="4" height="10" fill="${c}"/>`).join('')}</pattern>
</defs>`;

// ---- back layer: halo, back hair ----
let back = `<ellipse cx="60" cy="143" rx="36" ry="4.6" fill="rgba(18,48,74,.18)"/>`;
if (acc.includes('halo')) back += `<circle cx="60" cy="38" r="34" fill="${u('glow')}" opacity=".6"/><circle cx="60" cy="38" r="26" fill="none" stroke="#f2c75c" stroke-width="1.4" opacity=".7"/>`;
if (f.hairStyle === 'long') back += `<path d="M42 40 C35 56 36 76 40 94 Q47 90 52 94 Q60 88 68 94 Q73 90 80 94 C84 76 85 56 78 40 C76 28 68 21 60 21 C52 21 44 28 42 40Z" fill="${u('h')}" stroke="${hairD}" stroke-opacity=".5" stroke-width=".6"/>`;
if (f.hairStyle === 'braid') back += `<path d="M42 40 C37 58 38 78 42 98 L78 98 C82 78 83 58 78 40 C76 28 68 21 60 21 C52 21 44 28 42 40Z" fill="${u('h')}"/>`;

// ---- tunic ----
let body = `<path d="M34 139 C35 112 36 92 38 80 C40 70 49 65 60 65 C71 65 80 70 82 80 C84 92 85 112 86 139 Q60 146 34 139Z" fill="${bodyFill}"/>`;
body += `<path d="M34 139 C35 112 36 92 38 80 C40 70 49 65 60 65 C71 65 80 70 82 80 C84 92 85 112 86 139 Q60 146 34 139Z" fill="${u('sh')}"/>`;
body += `<path d="M50 96 C49 112 48 128 47 142 M60 98 C60 114 60 130 60 145 M70 96 C71 112 72 128 73 142" stroke="${robeD}" stroke-opacity=".3" stroke-width="1.2" fill="none"/>`;
body += `<path d="M55 100 C54 114 53 128 52 141" stroke="#fff" stroke-opacity=".14" stroke-width="1.4" fill="none"/>`;
// sash
body += `<path d="M36 100 Q60 108 84 100 L84.6 108.6 Q60 117 35.4 108.6Z" fill="${sash}"/><path d="M36 100 Q60 108 84 100" stroke="${lt(sash, 0.45)}" stroke-width=".8" fill="none" opacity=".8"/><path d="M35.4 108.6 Q60 117 84.6 108.6" stroke="${sashD}" stroke-width=".8" fill="none"/>`;
body += `<path d="M63 110 L58.5 127 L63.5 124 L65.5 129.5 L69.5 112Z" fill="${sashD}"/><ellipse cx="66" cy="108.2" rx="3.6" ry="3" fill="${sash}" stroke="${sashD}" stroke-width=".7"/>`;

// ---- mantle / coat ----
let cloak = '';
if (isCoat) {
  cloak += `<path d="M29 140 C28 108 30 88 37 77 C43 67 52 63 60 63 C68 63 77 67 83 77 C90 88 92 108 91 140 Q60 148 29 140Z" fill="${u('pat')}"/><path d="M29 140 C28 108 30 88 37 77 C43 67 52 63 60 63 C68 63 77 67 83 77 C90 88 92 108 91 140 Q60 148 29 140Z" fill="${u('sh')}"/>`;
  cloak += `<path d="M44 90 C43 108 42 124 41 142 M76 90 C77 108 78 124 79 142" stroke="#000" stroke-opacity=".12" stroke-width="1.2" fill="none"/>`;
  cloak += `<path d="M29.4 138 Q60 146 90.6 138" stroke="#f2c75c" stroke-width="2" fill="none"/>`;
} else {
  cloak += `<path fill-rule="evenodd" fill="${u('m')}" d="M29 140 C28 108 30 88 37 77 C43 67 52 63 60 63 C68 63 77 67 83 77 C90 88 92 108 91 140 Q60 148 29 140Z M52 66 Q60 76 68 66 C70 90 73 118 75 140 L45 140 C47 118 50 90 52 66Z"/>`;
  cloak += `<path d="M52 66 C50 90 47 118 45 140 M68 66 C70 90 73 118 75 140" stroke="${lt(mant, 0.45)}" stroke-width="1.6" fill="none" opacity=".85"/>`;
  cloak += `<path d="M38 100 C37 114 36 128 36 140 M82 100 C83 114 84 128 84 140 M31 110 C31 122 31 132 31 140 M89 110 C89 122 89 132 89 140" stroke="${mantD}" stroke-opacity=".4" stroke-width="1.2" fill="none"/>`;
  cloak += `<path d="M41 80 C39 92 38 104 38 114" stroke="#fff" stroke-opacity=".15" stroke-width="2" fill="none"/>`;
  cloak += `<path d="M29.4 138.5 Q60 146.5 90.6 138.5" stroke="${lt(mant, 0.5)}" stroke-width="1.6" fill="none" opacity=".7"/>`;
}
// chest V + collar
cloak += `<path d="M51.5 64.5 Q60 83 68.5 64.5Z" fill="${skinD}"/><path d="M51.5 64.5 Q60 83 68.5 64.5" stroke="${lt(robe, 0.35)}" stroke-width="1.8" fill="none" stroke-linecap="round"/>`;
if (acc.includes('rope')) cloak += `<path d="M40 74 C48 96 64 114 82 132" stroke="#b89a5e" stroke-width="2.6" fill="none" stroke-linecap="round"/><path d="M40 74 C48 96 64 114 82 132" stroke="#6b5430" stroke-width="2.6" fill="none" stroke-dasharray="1.6 2" stroke-linecap="round" opacity=".6"/><ellipse cx="46" cy="124" rx="6" ry="3" fill="none" stroke="#b89a5e" stroke-width="2"/><ellipse cx="46" cy="126.5" rx="6" ry="3" fill="none" stroke="#a08448" stroke-width="2"/>`;

// ---- neck + head ----
let head = `<path d="M53.5 52 L53 67 Q60 73 67 67 L66.5 52Z" fill="${u('s')}"/><path d="M53.3 58 Q60 66 66.7 58 L66.6 52 L53.4 52Z" fill="${skinS}" opacity=".5"/>`;
if (acc.includes('necklace')) head += `<path d="M50 66 Q60 79 70 66" stroke="#f2c75c" stroke-width="1.6" fill="none"/><circle cx="60" cy="77.4" r="2.6" fill="#c2185b" stroke="#f2c75c" stroke-width=".9"/><circle cx="53.6" cy="72.6" r="1.3" fill="#2f9e8f"/><circle cx="66.4" cy="72.6" r="1.3" fill="#2f9e8f"/>`;
// ears
head += `<ellipse cx="44.6" cy="43.5" rx="2.7" ry="4.2" fill="${skin}"/><path d="M44.2 41.6 Q46 43.5 44.4 45.8" stroke="${skinS}" stroke-width=".8" fill="none"/><ellipse cx="75.4" cy="43.5" rx="2.7" ry="4.2" fill="${skin}"/><path d="M75.8 41.6 Q74 43.5 75.6 45.8" stroke="${skinS}" stroke-width=".8" fill="none"/>`;
// face
const faceD = 'M60 24 C71 24 76 33 75.5 42 C75 52 68 60 60 60 C52 60 45 52 44.5 42 C44 33 49 24 60 24Z';
head += `<path d="${faceD}" fill="${u('s')}"/><path d="M60 24 C71 24 76 33 75.5 42 C75 52 68 60 60 60 C64 52 66.5 38 60 24Z" fill="${skinD}" opacity=".22"/>`;
head += `<ellipse cx="53" cy="33" rx="5" ry="3" fill="#fff" opacity=".12"/>`;
if (f.hairStyle === 'bald') head += `<ellipse cx="55" cy="28.5" rx="6" ry="2.6" fill="#fff" opacity=".28"/>`;
head += `<circle cx="50" cy="48" r="3.6" fill="#e0606a" opacity="${fem ? 0.34 : 0.22}"/><circle cx="70" cy="48" r="3.6" fill="#e0606a" opacity="${fem ? 0.34 : 0.22}"/>`;
head += `<path d="M59.6 40.5 C58.8 44.4 57.2 46.4 58.3 48.2 Q60 49.5 61.9 48.2" stroke="${skinS}" stroke-width="1" fill="none" stroke-linecap="round" opacity=".75"/>`;
if (acc.includes('stubble')) head += `<path d="M46.5 47 C48 58 54 60 60 60 C66 60 72 58 73.5 47 C70 55 66 56.5 60 56.5 C54 56.5 50 55 46.5 47Z" fill="${hair}" opacity=".3"/>`;
// beard
if (f.beard) {
  const st = f.beardStyle ?? 'medium';
  const L = st === 'long' ? 100 : st === 'forked' ? 98 : st === 'medium' ? 77 : 69;
  let bp: string;
  if (st === 'forked') {
    bp = `M44 42 C42.5 56 45 66 51 78 C52 86 53 ${L - 8} 52.5 ${L} C56 ${L - 6} 58.5 ${L - 14} 60 ${L - 18} C61.5 ${L - 14} 64 ${L - 6} 67.5 ${L} C67 ${L - 8} 68 86 69 78 C75 66 77.5 56 76 42 C73 54 67 58.5 60 58.5 C53 58.5 47 54 44 42Z`;
  } else if (st === 'short') {
    bp = `M44.5 42 C44 54 47 62 53 67 Q60 73 67 67 C73 62 76 54 75.5 42 C73 52 67 58.5 60 58.5 C53 58.5 47 52 44.5 42Z`;
  } else {
    const w = st === 'long' ? 1 : 0.6;
    bp = `M44 42 C42.5 56 45 66 51 76 C${54 - w} ${L - 12} 57 ${L - 4} 60 ${L} C63 ${L - 4} ${66 + w} ${L - 12} 69 76 C75 66 77.5 56 76 42 C73 54 67 58.5 60 58.5 C53 58.5 47 54 44 42Z`;
  }
  head += `<path d="${bp}" fill="${u('h')}" stroke="${hairD}" stroke-opacity=".55" stroke-width=".6" stroke-linejoin="round"/>`;
  const top = 60, bot = st === 'short' ? 68 : L - 3;
  for (let i = -3; i <= 3; i++) {
    const x0 = 60 + i * 4.3, x1 = 60 + i * (st === 'short' ? 2.4 : 2.9), y0 = 59 + Math.abs(i) * 1.1, y1 = bot - Math.abs(i) * (bot - top) / 4.5;
    head += `<path d="M${x0} ${y0} Q${x0 + i * 1.6} ${(y0 + y1) / 2} ${x1} ${y1}" stroke="${i % 2 ? hairD : lt(hair, 0.4)}" stroke-width=".8" stroke-opacity=".38" fill="none" stroke-linecap="round"/>`;
  }
  // moustache + mouth
  head += `<path d="M52 51.6 Q56.5 49.2 60 51.4 Q63.5 49.2 68 51.6 Q64 56 60 54 Q56 56 52 51.6Z" fill="${u('h')}" stroke="${hairD}" stroke-opacity=".5" stroke-width=".5"/>`;
  head += `<path d="M57.4 56 Q60 57.4 62.6 56" stroke="#7a3328" stroke-width="1.1" fill="none" stroke-linecap="round"/>`;
} else if (fem) {
  head += `<path d="M55.2 52.6 Q57.6 51.2 60 52.3 Q62.4 51.2 64.8 52.6 Q60 56.4 55.2 52.6Z" fill="#c9505a"/><path d="M55.6 52.8 Q60 54.2 64.4 52.8" stroke="#8e2f3a" stroke-width=".6" fill="none"/>`;
} else {
  head += `<path d="M55.3 52.4 Q57.6 51.4 60 52.2 Q62.4 51.4 64.7 52.4 Q60 56 55.3 52.4Z" fill="#c26257"/><path d="M55 52.5 Q60 55.6 65 52.5" stroke="#8a3a2c" stroke-width=".7" fill="none" stroke-linecap="round"/>`;
}
// eyes
const eye = (cx: number) => `<ellipse cx="${cx}" cy="41" rx="2.8" ry="2" fill="#fff"/><circle cx="${cx + 0.1}" cy="41.1" r="1.75" fill="#4a2f1e"/><circle cx="${cx + 0.1}" cy="41.1" r=".95" fill="#16090a"/><circle cx="${cx + 0.8}" cy="40.3" r=".6" fill="#fff"/><path d="M${cx - 3} 40.7 Q${cx} 38.5 ${cx + 3} 40.7" stroke="#2c1a10" stroke-width="${fem ? 1.3 : 1}" fill="none" stroke-linecap="round"/>`;
head += eye(53.5) + eye(66.5);
if (fem) head += `<path d="M50.5 40.4 L49.4 39.2 M69.5 40.4 L70.6 39.2" stroke="#2c1a10" stroke-width=".9" stroke-linecap="round"/>`;
head += `<path d="M50.8 43.6 Q53.5 45 56.2 43.6 M63.8 43.6 Q66.5 45 69.2 43.6" stroke="${skinS}" stroke-width=".6" fill="none" opacity=".55"/>`;
const bw = fem || f.age === 'young' ? 1.5 : 2;
head += `<path d="M49 37.4 Q53 34.6 57.6 36.4 M62.4 36.4 Q67 34.6 71 37.4" stroke="${browC}" stroke-width="${bw}" fill="none" stroke-linecap="round"/>`;
if (elder || f.hairStyle === 'bald' || f.age === 'adult') {
  head += `<path d="M51 30.5 Q60 28.6 69 30.5" stroke="${skinS}" stroke-width=".6" fill="none" opacity=".4"/>`;
  head += `<path d="M47.2 41 L45.8 40 M47.2 42.6 L45.6 42.8 M72.8 41 L74.2 40 M72.8 42.6 L74.4 42.8" stroke="${skinS}" stroke-width=".5" opacity=".5"/>`;
}

// ---- top hair / headwear ----
let top = '';
const cap = `M43.5 42 C41.5 24 50 15.5 60 15.5 C70 15.5 78.5 24 76.5 42 C75.5 35 73 31 69 29.5 C64 33 55 33 51 29.5 C47 31 44.5 35 43.5 42Z`;
const hairPaint = `fill="${u('h')}" stroke="${hairD}" stroke-opacity=".5" stroke-width=".6" stroke-linejoin="round"`;
switch (f.hairStyle) {
  case 'short': top += `<path d="${cap}" ${hairPaint}/><path d="M52 21 Q60 17.5 68 21 M49 25 Q60 20 71 25" stroke="${lt(hair, 0.4)}" stroke-width=".8" fill="none" opacity=".5"/>`; break;
  case 'long': top += `<path d="M43.5 44 C41 26 50 15.5 60 15.5 C70 15.5 79 26 76.5 44 C75.5 36 72 31.5 67 29.5 C63 32 61 31 60 30 C59 31 57 32 53 29.5 C48 31.5 44.5 36 43.5 44Z" ${hairPaint}/><path d="M60 16 C58 22 56 26 52 30 M60 16 C62 22 64 26 68 30 M50 19 C48 24 46 30 45 38 M70 19 C72 24 74 30 75 38" stroke="${hairD}" stroke-width=".7" fill="none" opacity=".35"/>`; break;
  case 'wavy': top += `<path d="${cap}" ${hairPaint}/><path d="M43.5 40 C40 48 41 54 44.5 58 C46 52 45.5 47 46.5 42Z M76.5 40 C80 48 79 54 75.5 58 C74 52 74.5 47 73.5 42Z" ${hairPaint}/><path d="M50 30 Q54 25 60 29 Q66 25 70 30" stroke="${hairD}" stroke-width=".9" fill="none" opacity=".45"/>`; break;
  case 'rough': top += `<path d="${cap}" ${hairPaint}/><path d="M47 24 L42 12 L53 19Z M55 18 L54 6 L63 16Z M64 17 L72 7 L70 21Z M72 22 L81 14 L77 28Z M44 32 L36 25 L46 24Z M76 32 L84 28 L76 24Z" ${hairPaint}/><path d="M50 22 L53 29 M58 21 L59 28 M68 22 L66 29" stroke="${hairD}" stroke-width=".8" opacity=".5"/>`; break;
  case 'curly': {
    const r = elder ? 5.2 : 6;
    let cc = '';
    for (let a = -178; a <= -2; a += 16) {
      const rad = (a * Math.PI) / 180;
      cc += `<circle cx="${(60 + 19.5 * Math.cos(rad)).toFixed(1)}" cy="${(37 + 21 * Math.sin(rad)).toFixed(1)}" r="${r}" ${hairPaint}/>`;
    }
    cc += `<circle cx="49" cy="29" r="4.6" ${hairPaint}/><circle cx="56" cy="26.5" r="4.6" ${hairPaint}/><circle cx="64" cy="26.5" r="4.6" ${hairPaint}/><circle cx="71" cy="29" r="4.6" ${hairPaint}/><circle cx="44" cy="37" r="4" ${hairPaint}/><circle cx="76" cy="37" r="4" ${hairPaint}/>`;
    top += cc; break;
  }
  case 'braid': top += `<path d="M43.5 42 C41.5 24 50 15.5 60 15.5 C70 15.5 78.5 24 76.5 42 C75.5 35 72 31 66 28.5 C62 31 58 30 54 28.5 C48 31 45 36 43.5 42Z" ${hairPaint}/><path d="M60 16 L60 29" stroke="${hairD}" stroke-width=".8" opacity=".5"/>`; break;
  case 'bald': top += `<path d="M43.7 42 C42.7 34 44 28 46.8 24.5 C46.2 30 46.6 36 47.8 41Z M76.3 42 C77.3 34 76 28 73.2 24.5 C73.8 30 73.4 36 72.2 41Z" ${hairPaint}/>`; break;
}
if (f.head === 'cloth') {
  const cl = lt(robe, 0.6);
  top += `<path d="M38 46 C36 22 47 12 60 12 C73 12 84 22 82 46 C82 56 84 64 91 76 C80 79 72 72 72 62 C71 54 70 48 70 40 C66 34 54 34 50 40 C50 48 49 54 48 62 C48 72 40 79 29 76 C36 64 38 56 38 46Z" fill="${cl}" stroke="${dk(cl, 0.25)}" stroke-width=".7"/>`;
  top += `<path d="M42 30 C46 17 74 17 78 30" stroke="${dk(cl, 0.15)}" stroke-width=".8" fill="none" opacity=".6"/><path d="M38.6 29 Q60 17 81.4 29" stroke="#3b2a1e" stroke-width="3.4" fill="none" stroke-linecap="round"/><path d="M38.6 29 Q60 17 81.4 29" stroke="#6a4a2a" stroke-width="1.2" fill="none" stroke-dasharray="2 2" stroke-linecap="round"/>`;
  top += `<path d="M33 70 L35 76 M37 66 L38.5 72 M87 70 L85 76 M83 66 L81.5 72" stroke="${a1(cl)}" stroke-width="1.2" opacity=".7"/>`;
}
function a1(c: string) { return dk(c, 0.3); }
if (f.head === 'crown') {
  if (fem) {
    top += `<path d="M45.5 27 L46.5 11 L53 19 L60 5.5 L67 19 L73.5 11 L74.5 27 Q60 22.5 45.5 27Z" fill="${u('g')}" stroke="#a87a22" stroke-width=".8" stroke-linejoin="round"/>`;
    top += `<circle cx="60" cy="13" r="2" fill="#c2185b" stroke="#fff3c4" stroke-width=".5"/><circle cx="46.8" cy="11" r="1.3" fill="#fff"/><circle cx="73.2" cy="11" r="1.3" fill="#fff"/><circle cx="60" cy="5.6" r="1.1" fill="#fff"/><circle cx="52" cy="24.4" r="1.4" fill="#2f9e8f"/><circle cx="60" cy="23.8" r="1.6" fill="#c2185b"/><circle cx="68" cy="24.4" r="1.4" fill="#2f9e8f"/>`;
  } else {
    top += `<path d="M46 28.5 Q60 21.5 74 28.5 L74 32.5 Q60 26 46 32.5Z" fill="${u('g')}" stroke="#a87a22" stroke-width=".7"/><path d="M52 24.5 L54 19.5 L57 23.5 L60 17.5 L63 23.5 L66 19.5 L68 24.5" fill="${u('g')}" stroke="#a87a22" stroke-width=".7" stroke-linejoin="round"/><circle cx="60" cy="26.6" r="1.7" fill="#c2185b" stroke="#fff3c4" stroke-width=".4"/>`;
  }
}
if (acc.includes('earrings')) top += `<circle cx="44.2" cy="48.6" r="2" fill="${u('g')}" stroke="#a87a22" stroke-width=".4"/><circle cx="75.8" cy="48.6" r="2" fill="${u('g')}" stroke="#a87a22" stroke-width=".4"/>`;
if (f.head === 'veil') {
  top += `<path fill-rule="evenodd" fill="${u('m')}" stroke="${mantD}" stroke-opacity=".5" stroke-width=".6" d="M60 14.5 C42 14.5 33 29 34 48 C35 62 30 76 23 90 L97 90 C90 76 85 62 86 48 C87 29 78 14.5 60 14.5Z M60 25 C51 25 45.5 32 45.5 42 C45.5 53 51 59.5 60 59.5 C69 59.5 74.5 53 74.5 42 C74.5 32 69 25 60 25Z"/>`;
  top += `<path d="M45.5 42 C45.5 32 51 25 60 25 C69 25 74.5 32 74.5 42" stroke="${robe}" stroke-width="2.2" fill="none" opacity=".85"/><path d="M40 28 C37 44 38 62 30 84 M80 28 C83 44 82 62 90 84 M60 62 C60 72 59 82 57 90" stroke="${mantD}" stroke-opacity=".28" stroke-width="1.2" fill="none"/><path d="M45 20 C40 26 38 34 38 42" stroke="#fff" stroke-opacity=".5" stroke-width="2" fill="none" stroke-linecap="round"/>`;
  top += `<path d="M24 88 Q60 96 96 88" stroke="${robe}" stroke-width="1.6" fill="none" opacity=".8"/>`;
}
// braid over left shoulder
if (f.hairStyle === 'braid') {
  for (let i = 0; i < 9; i++) {
    const cx = 47 - i * 0.55 + (i % 2 ? 1.4 : -1.2), cy = 58 + i * 5.2;
    top += `<ellipse cx="${cx.toFixed(1)}" cy="${cy.toFixed(1)}" rx="3.6" ry="3.4" fill="${i % 2 ? hairL : hair}" stroke="${hairD}" stroke-opacity=".6" stroke-width=".5"/>`;
  }
