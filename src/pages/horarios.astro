---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { schedule, days, site } from '../data/site';
const byDay = days.map((d) => ({ day: d, items: schedule.filter((a) => a.day === d) })).filter((d) => d.items.length);
---
<Base title="Horarios" description="Días y horarios de las reuniones y actividades de la iglesia.">
  <PageHero eyebrow="Horarios" title="Cuándo nos reunimos" lead="Todas las actividades de la semana. Cualquier día es un buen día para acercarte." />
  <section class="section">
    <div class="container">
      <div class="week">
        {byDay.map((d) => (
          <div class="day reveal">
            <div class="dayname">{d.day}</div>
            <div class="list">
              {d.items.map((a) => (
                <div class="act">
                  <span class="time">{a.time}<small> hs</small></span>
                  <div><h3>{a.name}</h3><p>{a.desc}</p></div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      <p class="center muted" style="margin-top:2.5rem">Los horarios pueden cambiar en fechas especiales. Consultanos por <a href={`https://wa.me/${site.whatsapp}`}>WhatsApp</a>.</p>
    </div>
  </section>
</Base>

<style>
  .week { display: grid; gap: 1.2rem; }
  .day { display: grid; grid-template-columns: 200px 1fr; background: #fff; border-radius: var(--radius); overflow: hidden; border: 1px solid rgba(59,42,140,.08); box-shadow: 0 10px 40px -22px rgba(11,16,51,.3); }
  .dayname { background: linear-gradient(160deg, var(--royal), var(--night)); color: var(--gold-soft); font-family: var(--font-display); font-size: 2rem; font-weight: 600; padding: 2rem 1.5rem; display: grid; align-items: center; }
  .list { padding: 1rem 1.5rem; display: grid; gap: .3rem; }
  .act { display: grid; grid-template-columns: 110px 1fr; gap: 1rem; align-items: center; padding: 1rem 0; }
  .act + .act { border-top: 1px dashed rgba(59,42,140,.2); }
  .time { font-family: var(--font-display); font-size: 2.2rem; font-weight: 700; color: var(--royal); }
  .time small { font-size: .9rem; font-family: var(--font-body); color: var(--muted); font-weight: 500; }
  .act h3 { font-size: 1.4rem; margin: 0; }
  .act p { margin: 0; color: var(--muted); }
  @media (max-width: 700px) { .day { grid-template-columns: 1fr; } .dayname { padding: 1rem 1.5rem; font-size: 1.6rem; } .act { grid-template-columns: 1fr; gap: .2rem; } }
</style>
