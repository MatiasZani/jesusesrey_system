---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { beliefs, site, timeline } from '../data/site';
const leaders = [
  { name: 'Pastor principal', role: 'Pastor' },
  { name: 'Pastora', role: 'Pastora' },
  { name: 'Líder de alabanza', role: 'Alabanza' },
  { name: 'Líder de jóvenes', role: 'Jóvenes' },
];
---
<Base title="Nosotros" description="Nuestra historia, misión, visión, creencias y liderazgo.">
  <PageHero eyebrow="Sobre nosotros" title="Quiénes somos" lead={`${site.name}, una familia de fe en ${site.city}.`} />

  <section class="section">
    <div class="container grid cols-3">
      {[['Misión', 'Contenido a completar: por qué existimos como iglesia.'], ['Visión', 'Contenido a completar: lo que soñamos para nuestra ciudad.'], ['Valores', 'Contenido a completar: lo que nos define como familia.']].map(([t, d]) => (
        <div class="card reveal center"><h3>{t}</h3><p>{d}</p></div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container center"><span class="eyebrow">Nuestra historia</span><h2>Lo que Dios ha hecho</h2><div class="divider">✦</div></div>
    <div class="container line">
      {timeline.map((t, i) => (
        <div class:list={['item reveal', { right: i % 2 }]}>
          <div class="dot"></div>
          <div class="card"><span class="eyebrow">{t.year}</span><h3>{t.title}</h3><p>{t.desc}</p></div>
        </div>
      ))}
    </div>
  </section>

  <section class="section dark">
    <div class="stars"></div>
    <div class="container center">
      <span class="eyebrow">Lo que creemos</span>
      <h2>Nuestras creencias</h2>
      <div class="divider">✦</div>
      <div class="grid cols-3">
        {beliefs.map((b) => <div class="card reveal"><h3>{b.name}</h3><p>{b.desc}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container center">
      <span class="eyebrow">Liderazgo</span>
      <h2>Quienes nos guían</h2>
      <div class="divider">✦</div>
      <div class="grid cols-4">
        {leaders.map((l) => (
          <div class="reveal">
            <div class="avatar float" aria-hidden="true">✝</div>
            <h3>{l.name}</h3><p class="muted">{l.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .avatar { width: 150px; aspect-ratio: 1; margin: 0 auto 1rem; border-radius: 50%; display: grid; place-items: center; font-size: 3rem; color: var(--gold);
    background: radial-gradient(circle at 30% 25%, var(--royal), var(--night)); box-shadow: 0 0 0 4px var(--gold-soft), var(--glow); }
</style>

<style>
  .line { position: relative; max-width: 860px; display: grid; gap: 2.5rem; }
  .line::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; background: linear-gradient(var(--gold), var(--gold-soft)); box-shadow: 0 0 14px var(--gold); transform: translateX(-50%) scaleY(var(--p, 1)); transform-origin: top; }
  .item { position: relative; width: 50%; padding-right: 3rem; }
  .item.right { margin-left: 50%; padding-right: 0; padding-left: 3rem; }
  .item.in .dot { animation: ping 2.4s ease-out infinite; }
  @keyframes ping { 70% { box-shadow: 0 0 0 16px rgba(242,199,92,0), var(--glow); } }
  .dot { position: absolute; top: 2rem; right: -9px; width: 18px; height: 18px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 6px rgba(242,199,92,.25), var(--glow); }
  .item.right .dot { right: auto; left: -9px; }
  @media (max-width: 700px) {
    .line::before { left: 9px; }
    .item, .item.right { width: 100%; margin-left: 0; padding: 0 0 0 2.5rem; }
    .dot, .item.right .dot { left: 0; right: auto; }
  }
</style>
