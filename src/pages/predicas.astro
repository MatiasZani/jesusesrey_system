---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { sermons } from '../data/site';
---
<Base title="Prédicas" description="Mensajes y prédicas de la Iglesia Jesús es Rey.">
  <PageHero eyebrow="Prédicas" title="La Palabra de Dios" lead="Mirá y escuchá los mensajes de nuestras reuniones." />
  <section class="section">
    <div class="container grid cols-3">
      {sermons.map((s) => (
        <article class="card reveal">
          <div class="thumb" aria-hidden="true">▶</div>
          <span class="eyebrow">{s.ref}</span>
          <h3>{s.title}</h3>
          <p>{s.speaker} · {s.date}</p>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .card:hover .thumb { box-shadow: var(--glow); }
  .thumb { transition: box-shadow .4s; aspect-ratio: 16/9; border-radius: 14px; margin-bottom: 1.2rem; display: grid; place-items: center; color: var(--gold); font-size: 2.5rem;
    background: radial-gradient(circle at 50% 0%, var(--royal), var(--night)); }
</style>
