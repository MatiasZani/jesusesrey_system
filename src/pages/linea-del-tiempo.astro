---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FigureAvatar from '../components/FigureAvatar.astro';
import { figures } from '../data/figures';
import { eras, slug } from '../data/timeline';

const byName = new Map(figures.map((f) => [f.name, f]));
const seen = new Set<string>();
const view = eras.map((e) => ({
  ...e,
  people: e.people.map((p) => {
    const fig = byName.get(p.name);
    const first = !seen.has(p.name);
    if (first) seen.add(p.name);
    return { ...p, fig, id: first ? slug(p.name) : undefined };
  }),
}));
---
<Base title="Línea del tiempo de la Biblia" description="Recorré la historia de la Biblia de la creación a la iglesia primitiva: épocas, personajes e historias.">
  <PageHero eyebrow="Recorrido bíblico" title="Línea del tiempo de la Biblia" lead="De la creación a la iglesia primitiva. Elegí una época y conocé a sus personajes y sus historias." />

  <nav class="eras" id="eras" aria-label="Épocas">
    <div class="container eras-in">
      {view.map((e) => <a href={`#${e.id}`} data-era={e.id}><span>{e.icon}</span>{e.title}</a>)}
    </div>
  </nav>

  <section class="section tl">
    <div class="container line">
      {view.map((e) => (
        <article class="era" id={e.id}>
          <div class="marker" aria-hidden="true">{e.icon}</div>
          <div class="body">
            <span class="eyebrow">{e.dates}</span>
            <h2>{e.title}</h2>
            <p class="lead muted">{e.summary}</p>

            <h3 class="sub">Referentes</h3>
            <div class="people">
              {e.people.map((p) => p.fig ? (
                <a class="person" id={p.id} href={`#${p.id ?? slug(p.name)}`}>
                  <FigureAvatar f={p.fig} />
                  <strong>{p.name}</strong>
                  <small>{p.role}</small>
                  <em>{p.fig.desc}</em>
                </a>
              ) : (
                <div class="person plain">
                  <div class="initial">{p.name.charAt(0)}</div>
                  <strong>{p.name}</strong>
                  <small>{p.role}</small>
                </div>
              ))}
            </div>

            <h3 class="sub">Historias</h3>
            <div class="stories">
              {e.stories.map((s) => (
                <details>
                  <summary><span>{s.title}</span><code>{s.ref}</code></summary>
                  <p>{s.text}</p>
                </details>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .eras { position: sticky; top: 72px; z-index: 40; background: rgba(243, 250, 255, .92); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(26,120,184,.15); }
  .eras-in { display: flex; gap: .5rem; overflow-x: auto; padding: .7rem 0; scrollbar-width: none; }
  .eras-in::-webkit-scrollbar { display: none; }
  .eras a { flex: none; display: inline-flex; gap: .4rem; align-items: center; padding: .45rem .9rem; border-radius: 999px; text-decoration: none; color: var(--ink); font-size: .9rem; font-weight: 500; border: 1px solid rgba(26,120,184,.2); background: #fff; transition: background .2s, color .2s; }
  .eras a:hover { background: rgba(26,120,184,.1); }
  .eras a.on { background: var(--night); color: #fff; border-color: var(--night); }

  .line { position: relative; padding-left: 4.2rem; }
  .line::before { content: ''; position: absolute; left: 1.55rem; top: 0; bottom: 0; width: 3px; border-radius: 3px; background: linear-gradient(var(--royal), var(--gold), var(--night-2)); }
  .era { position: relative; padding-bottom: 4rem; scroll-margin-top: 140px; }
  .era:last-child { padding-bottom: 0; }
  .marker { position: absolute; left: -4.2rem; top: 0; width: 3.2rem; height: 3.2rem; display: grid; place-items: center; font-size: 1.5rem; background: #fff; border: 3px solid var(--night-2); border-radius: 50%; box-shadow: 0 6px 18px -6px rgba(26,120,184,.5); }
  .body h2 { margin: .2rem 0 .6rem; }
  .sub { margin: 1.8rem 0 .8rem; font-size: 1.1rem; letter-spacing: .08em; text-transform: uppercase; color: var(--night); }

  .people { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 1rem; }
  .person { display: flex; flex-direction: column; align-items: center; text-align: center; gap: .15rem; padding: 1rem .9rem 1.1rem; background: #fff; border: 1px solid rgba(26,120,184,.14); border-radius: var(--radius); text-decoration: none; color: inherit; scroll-margin-top: 150px; box-shadow: 0 10px 28px -20px rgba(26,120,184,.5); transition: transform .3s, box-shadow .3s, border-color .3s; }
  .person :global(svg) { width: 110px; height: auto; }
  .person strong { font-family: var(--font-display); font-size: 1.35rem; color: var(--ink); }
  .person small { color: var(--night); font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; font-weight: 600; }
  .person em { font-style: normal; color: var(--muted); font-size: .85rem; margin-top: .4rem; }
  a.person:hover { transform: translateY(-4px); }
  .person:target { border-color: var(--gold); box-shadow: 0 0 0 4px rgba(242,199,92,.45), 0 18px 40px -18px rgba(26,120,184,.6); animation: pop .8s ease; }
  .person.plain { justify-content: center; min-height: 130px; background: rgba(255,255,255,.6); }
  .initial { width: 54px; height: 54px; border-radius: 50%; display: grid; place-items: center; font-family: var(--font-display); font-size: 1.7rem; color: #fff; background: linear-gradient(135deg, var(--night-2), var(--night)); margin-bottom: .3rem; }
  @keyframes pop { 0% { transform: scale(.94); } 60% { transform: scale(1.04); } 100% { transform: scale(1); } }

  .stories { display: grid; gap: .6rem; }
  details { background: #fff; border: 1px solid rgba(26,120,184,.14); border-radius: 14px; overflow: hidden; }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding: .9rem 1.1rem; font-weight: 600; color: var(--ink); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-size: 1.4rem; color: var(--night); transition: transform .25s; margin-left: auto; }
  details[open] summary::after { transform: rotate(45deg); }
  summary code { font-family: var(--font-body); font-size: .75rem; color: var(--night); background: rgba(26,120,184,.1); padding: .15rem .6rem; border-radius: 999px; font-weight: 500; }
  details p { margin: 0; padding: 0 1.1rem 1.1rem; color: var(--muted); }

  @media (max-width: 640px) {
    .line { padding-left: 3.2rem; } .line::before { left: 1.05rem; }
    .marker { left: -3.2rem; width: 2.6rem; height: 2.6rem; font-size: 1.2rem; }
    summary { flex-wrap: wrap; } summary code { order: 3; }
  }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('#eras a')];
  const bar = document.querySelector<HTMLElement>('.eras-in')!;
  const io = new IntersectionObserver((es) => {
    es.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((l) => l.classList.toggle('on', l.dataset.era === e.target.id));
      const on = bar.querySelector<HTMLElement>('a.on');
      if (on) bar.scrollTo({ left: on.offsetLeft - bar.clientWidth / 2 + on.offsetWidth / 2, behavior: 'smooth' });
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  document.querySelectorAll('.era').forEach((el) => io.observe(el));
</script>
