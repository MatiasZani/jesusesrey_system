---
import Base from '../layouts/Base.astro';
import FigureAvatar from '../components/FigureAvatar.astro';
import { figures } from '../data/figures';
import { eras, slug } from '../data/timeline';

const byName = new Map(figures.map((f) => [f.name, f]));
const seen = new Set<string>();
// people-grid geometry per era: desktop columns/rows and mobile columns/rows
const grid = (n: number) => {
  const cols = n <= 2 ? n : n <= 4 ? 2 : n <= 6 ? 3 : 4;
  const mcols = n <= 4 ? 2 : n <= 6 ? 3 : 4;
  return { cols, rows: Math.ceil(n / cols), mcols, mrows: Math.ceil(n / mcols) };
};
const view = eras.map((e) => ({
  ...e,
  grid: grid(e.people.length),
  people: e.people.map((p) => {
    const first = !seen.has(p.name);
    if (first) seen.add(p.name);
    return { ...p, fig: byName.get(p.name), slug: slug(p.name), first };
  }),
}));
---
<Base bare title="Línea del tiempo de la Biblia" description="Recorré la historia de la Biblia de la creación a la iglesia primitiva: épocas, personajes e historias.">
  <div class="app" id="app">
    <section class="rail" aria-label="Línea del tiempo">
      <h1>Línea del tiempo de la Biblia</h1>
      <ol class="nodes" id="nodes">
        <li class="bar" aria-hidden="true"><i id="fill"></i></li>
        {view.map((e, i) => (
          <li>
            <button type="button" class="node" data-i={i} aria-label={`${e.title}, ${e.dates}`}>
              <span class="dot">{e.icon}</span>
              <span class="lbl">{e.title}</span>
              <span class="dts">{e.dates}</span>
            </button>
          </li>
        ))}
      </ol>
    </section>

    <section class="stage" aria-roledescription="carrusel">
      <button class="arrow prev" id="prev" type="button" aria-label="Época anterior">‹</button>
      <div class="viewport" id="viewport">
        <div class="slides" id="slides">
          {view.map((e, i) => (
            <article class="slide" data-i={i} data-id={e.id} data-view="stories" aria-label={e.title}>
              <div class="info">
                <span class="eyebrow">{e.dates}</span>
                <h2>{e.title}</h2>
                <p class="sum">{e.summary}</p>
                <div class="seg" role="group" aria-label="Ver">
                  <button type="button" class="on" data-v="stories">Historias</button>
                  <button type="button" data-v="people">Referentes</button>
                </div>
                <h3 class="hs">Historias</h3>
                <div class="tabs" role="tablist">
                  {e.stories.map((s, k) => (
                    <button type="button" role="tab" class:list={['tab', { on: k === 0 }]} data-k={k}>{s.title}</button>
                  ))}
                </div>
                <div class="story">
                  {e.stories.map((s, k) => (
                    <div class:list={['sp', { on: k === 0 }]} data-k={k}><code>{s.ref}</code><p>{s.text}</p></div>
                  ))}
                </div>
              </div>
              <div class="folks">
                <h3 class="hp">Referentes</h3>
                <div class="people" data-n={e.people.length} style={`--cols:${e.grid.cols};--rows:${e.grid.rows};--mcols:${e.grid.mcols};--mrows:${e.grid.mrows}`}>
                  {e.people.map((p) => p.fig ? (
                    <div class="person" data-slug={p.first ? p.slug : undefined}>
                      <FigureAvatar f={p.fig} />
                      <strong>{p.name}</strong>
                      <small>{p.role}</small>
                      <em>{p.fig.desc}</em>
                    </div>
                  ) : (
                    <div class="person plain">
                      <div class="initial">{p.name.charAt(0)}</div>
                      <strong>{p.name}</strong>
                      <small>{p.role}</small>
                    </div>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
      <button class="arrow next" id="next" type="button" aria-label="Época siguiente">›</button>
      <div class="count" id="count" aria-live="polite"></div>
    </section>
  </div>
</Base>

<style is:global>
  body.bare { overflow: hidden; height: 100dvh; }
  body.bare #progress { display: none; }
</style>

<style>
  .app { height: 100dvh; padding-top: 72px; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr); background: radial-gradient(120% 80% at 50% 0%, #e6f4ff, var(--cream)); overflow: hidden; }

  /* ---- rail ---- */
  .rail { min-width: 0; padding: clamp(.5rem, 1.6vh, 1.1rem) 0 0; text-align: center; }
  .rail h1 { font-size: clamp(1.3rem, 3.2vh, 2rem); margin: 0 0 clamp(.3rem, 1.2vh, .8rem); color: var(--ink); }
  .nodes { list-style: none; margin: 0 auto; padding: 8px 1.2rem 4px; position: relative; display: flex; overflow-x: auto; scrollbar-width: none; max-width: 1400px; }
  .nodes::-webkit-scrollbar { display: none; }
  .nodes li:not(.bar) { flex: 1 0 96px; position: relative; z-index: 1; }
  .bar { position: absolute; left: 1.2rem; right: 1.2rem; top: calc(8px + clamp(30px, 5vh, 42px) / 2 - 1.5px); height: 3px; background: rgba(26,120,184,.2); border-radius: 3px; }
  .bar i { position: absolute; inset: 0 auto 0 0; width: 0; background: linear-gradient(90deg, var(--royal), var(--gold)); border-radius: 3px; transition: width .6s cubic-bezier(.4,0,.2,1); }
  .node { all: unset; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: .2rem; width: 100%; padding: 0 .2rem; box-sizing: border-box; }
  .dot { width: clamp(30px, 5vh, 42px); height: clamp(30px, 5vh, 42px); display: grid; place-items: center; font-size: clamp(.95rem, 2.4vh, 1.3rem); background: #fff; border: 3px solid rgba(26,120,184,.35); border-radius: 50%; transition: transform .3s, border-color .3s, background .3s, box-shadow .3s; }
  .lbl { font-size: clamp(.62rem, 1.5vh, .78rem); font-weight: 600; color: var(--ink); line-height: 1.15; max-width: 12ch; }
  .dts { font-size: clamp(.55rem, 1.3vh, .68rem); color: var(--muted); }
  .node:hover .dot { transform: scale(1.12); }
  .node:focus-visible .dot { outline: 3px solid var(--gold); outline-offset: 2px; }
  .node.past .dot { border-color: var(--night-2); }
  .node.on .dot { background: var(--night); border-color: var(--gold); transform: scale(1.25); box-shadow: 0 0 0 5px rgba(242,199,92,.35); }
  .node.on .lbl { color: var(--night); }

  /* ---- stage ---- */
  .stage { position: relative; min-height: 0; display: flex; padding: clamp(.4rem, 1.5vh, 1rem) 0 clamp(.8rem, 2.4vh, 1.6rem); }
  .viewport { flex: 1; min-width: 0; overflow: hidden; }
  .slides { display: flex; height: 100%; transition: transform .7s cubic-bezier(.65,.05,.25,1); will-change: transform; }
  .slide { flex: 0 0 100%; min-width: 0; height: 100%; box-sizing: border-box; padding: 0 clamp(3.4rem, 7vw, 6.5rem); display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); gap: clamp(1rem, 3vw, 3rem); align-items: center; overflow-y: auto; scrollbar-width: thin; }
  .slide > * { opacity: 0; transform: translateY(14px); transition: opacity .5s .25s, transform .5s .25s; }
  .app.init .slide > * { transition: none !important; }
  .slide.on > * { opacity: 1; transform: none; }
  .slide.on .folks { transition-delay: .4s; }

  .info h2 { margin: .15rem 0 .5rem; font-size: clamp(1.8rem, 5.2vh, 3.2rem); line-height: 1.05; }
  .sum { margin: 0 0 clamp(.5rem, 2vh, 1.2rem); color: var(--muted); font-size: clamp(.9rem, 2.1vh, 1.1rem); }
  h3 { margin: 0 0 .5rem; font-family: var(--font-body); font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; color: var(--night); }
  .tabs { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: .7rem; }
  .tab { all: unset; cursor: pointer; padding: .35rem .8rem; border-radius: 999px; font-size: clamp(.75rem, 1.8vh, .88rem); font-weight: 600; color: var(--ink); background: #fff; border: 1px solid rgba(26,120,184,.25); transition: background .2s, color .2s; }
  .tab:hover { background: rgba(26,120,184,.1); }
  .tab:focus-visible { outline: 3px solid var(--gold); }
  .tab.on { background: var(--night); color: #fff; border-color: var(--night); }
  .story { background: #fff; border: 1px solid rgba(26,120,184,.15); border-radius: 16px; padding: clamp(.7rem, 2vh, 1.1rem) 1.1rem; box-shadow: 0 12px 30px -22px rgba(26,120,184,.6); }
  .sp { display: none; }
  .sp.on { display: block; animation: fade .35s ease; }
  .sp code { font-family: var(--font-body); font-size: .72rem; font-weight: 600; color: var(--night); background: rgba(26,120,184,.1); padding: .12rem .6rem; border-radius: 999px; }
  .sp p { margin: .5rem 0 0; color: var(--ink); font-size: clamp(.88rem, 2vh, 1.02rem); }
  @keyframes fade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  /* the folks column fills the slide height; the grid rows share it and each avatar scales to its cell */
  .folks { align-self: stretch; min-height: 0; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
  .people { display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); grid-template-rows: repeat(var(--rows, 2), minmax(0, 1fr)); gap: clamp(.4rem, 1.4vh, .9rem); flex: 0 1 auto; min-height: 0; max-height: calc(var(--rows, 2) * 300px); height: 100%; }
  .person { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: .1rem; min-width: 0; min-height: 0; padding: clamp(.3rem, 1.2vh, .8rem) .4rem; background: #fff; border: 1px solid rgba(26,120,184,.14); border-radius: 18px; box-shadow: 0 10px 26px -20px rgba(26,120,184,.5); }
  .person :global(svg) { flex: 1 1 0; min-height: 0; width: 100%; height: auto; }
  .person strong { font-family: var(--font-display); font-size: clamp(.95rem, 2.3vh, 1.25rem); line-height: 1.1; color: var(--ink); }
  .person small { color: var(--night); font-size: clamp(.55rem, 1.3vh, .68rem); letter-spacing: .08em; text-transform: uppercase; font-weight: 600; line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .person em { display: none; font-style: normal; color: var(--muted); font-size: clamp(.7rem, 1.5vh, .8rem); margin-top: .15rem; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  /* descriptions only when there are few people and the screen is tall */
  @media (min-height: 760px) { .people[data-n="1"] .person em, .people[data-n="2"] .person em, .people[data-n="3"] .person em, .people[data-n="4"] .person em { display: -webkit-box; } }
  .person.plain { justify-content: center; background: rgba(255,255,255,.6); }
  .initial { width: clamp(40px, 8vh, 56px); aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center; font-family: var(--font-display); font-size: 1.6rem; color: #fff; background: linear-gradient(135deg, var(--night-2), var(--night)); margin-bottom: .2rem; }
  .person.hl { border-color: var(--gold); box-shadow: 0 0 0 4px rgba(242,199,92,.5), 0 18px 40px -18px rgba(26,120,184,.6); animation: pop .9s ease; }
  @keyframes pop { 0% { transform: scale(.92); } 55% { transform: scale(1.06); } 100% { transform: scale(1); } }

  .arrow { position: absolute; top: 50%; translate: 0 -50%; z-index: 5; width: clamp(44px, 6vh, 58px); height: clamp(44px, 6vh, 58px); border-radius: 50%; border: 0; cursor: pointer; background: var(--night); color: #fff; font-size: 2rem; line-height: 1; box-shadow: 0 10px 26px -8px rgba(0,0,0,.45); transition: transform .2s, background .2s, opacity .2s; }
  .arrow:hover:not(:disabled) { background: var(--night-2); transform: scale(1.1); }
  .arrow:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
  .arrow:disabled { opacity: .3; cursor: default; }
  .prev { left: clamp(.5rem, 2vw, 1.6rem); }
  .next { right: clamp(.5rem, 2vw, 1.6rem); }
  .count { position: absolute; bottom: 0; left: 50%; translate: -50% 0; font-size: .75rem; letter-spacing: .15em; color: var(--muted); font-weight: 600; }

  .seg { display: none; }
  @media (max-width: 860px) {
    .rail h1 { font-size: 1.05rem; margin-bottom: .2rem; }
    .dts { display: none; }
    .lbl { max-width: 9ch; }
    .sum { display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: .6rem; }
    .seg { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; padding: 4px; background: rgba(26,120,184,.12); border-radius: 999px; margin-bottom: .7rem; }
    .seg button { all: unset; cursor: pointer; text-align: center; padding: .45rem; border-radius: 999px; font-size: .85rem; font-weight: 600; color: var(--night); }
    .seg button.on { background: var(--night); color: #fff; }
    .hs, .hp { display: none; }
    .slide[data-view="stories"] .folks { display: none; }
    .slide[data-view="people"] .tabs, .slide[data-view="people"] .story { display: none; }
    .slide { align-content: start; }
    .person { padding: .35rem .25rem; border-radius: 14px; }
    .slide { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr); align-content: stretch; align-items: start; padding: .4rem 2.8rem .9rem; gap: .5rem; }
    .slide[data-view="stories"] { grid-template-rows: minmax(0, 1fr); }
    .folks { align-self: stretch; }
    .people { grid-template-columns: repeat(var(--mcols, 3), minmax(0, 1fr)); grid-template-rows: repeat(var(--mrows, 3), minmax(0, 1fr)); max-height: calc(var(--mrows, 3) * 190px); gap: .35rem; }
    .person em, .people[data-n] .person em { display: none; }
    .person strong { font-size: clamp(.78rem, 2.1vh, .98rem); display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .people:not([data-n="4"]) .person small { display: none; }
    .slide[data-view="people"] .sum { display: none; }
    .tab { font-size: .72rem; padding: .28rem .6rem; }
    .info h2 { font-size: clamp(1.5rem, 4.2vh, 2.2rem); }
    .sum { font-size: .88rem; }
    .arrow { width: 38px; height: 38px; font-size: 1.5rem; top: 40%; }
    .prev { left: .25rem; } .next { right: .25rem; }
  }
  @media (prefers-reduced-motion: reduce) { .slides, .slide > *, .bar i { transition: none; } }
</style>

<script>
  const slides = document.getElementById('slides')!;
  const items = [...slides.querySelectorAll<HTMLElement>('.slide')];
  const nodes = [...document.querySelectorAll<HTMLButtonElement>('.node')];
  const nodesBox = document.getElementById('nodes')!;
  const fill = document.getElementById('fill')!;
  const prev = document.getElementById('prev') as HTMLButtonElement;
  const next = document.getElementById('next') as HTMLButtonElement;
  const count = document.getElementById('count')!;
  const N = items.length;
  // shrink the active era just enough so it never needs a scrollbar
  const fit = () => {
    const s = items[cur]; if (!s) return;
    (s.style as any).zoom = '';
    const over = s.scrollHeight - s.clientHeight;
    if (over > 1) (s.style as any).zoom = String(Math.max(0.62, (s.clientHeight - 2) / s.scrollHeight));
  };
  let cur = -1;

  const go = (i: number, hl?: string) => {
    i = Math.max(0, Math.min(N - 1, i));
    cur = i;
    slides.style.transform = `translateX(${-i * 100}%)`;
    items.forEach((s, k) => { s.classList.toggle('on', k === i); (s as any).inert = k !== i; s.setAttribute('aria-hidden', String(k !== i)); });
    nodes.forEach((n, k) => { n.classList.toggle('on', k === i); n.classList.toggle('past', k < i); n.setAttribute('aria-current', k === i ? 'step' : 'false'); });
    // progress line: first node center -> last node center, filled up to the current one
    const cx = (el: HTMLElement) => el.offsetLeft + el.offsetWidth / 2;
    const x0 = cx(nodes[0].parentElement as HTMLElement), x1 = cx(nodes[N - 1].parentElement as HTMLElement), xi = cx(nodes[i].parentElement as HTMLElement);
    const bar = fill.parentElement as HTMLElement;
    bar.style.left = `${x0}px`; bar.style.right = 'auto'; bar.style.width = `${x1 - x0}px`;
    fill.style.width = `${xi - x0}px`;
    nodes[i].scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
    prev.disabled = i === 0; next.disabled = i === N - 1;
    count.textContent = `${i + 1} / ${N}`;
    fit();
    document.querySelectorAll('.person.hl').forEach((p) => p.classList.remove('hl'));
    if (hl) items[i].querySelector(`.person[data-slug="${hl}"]`)?.classList.add('hl');
    else history.replaceState(null, '', `#${items[i].dataset.id}`);
  };

  const fromHash = () => {
    const h = decodeURIComponent(location.hash.slice(1));
    if (!h) return 0;
    const byEra = items.findIndex((s) => s.dataset.id === h);
    if (byEra >= 0) return { i: byEra };
    const byPerson = items.findIndex((s) => s.querySelector(`.person[data-slug="${h}"]`));
    return byPerson >= 0 ? { i: byPerson, hl: h } : 0;
  };
  const start = fromHash();
  const app = document.getElementById('app')!;
  app.classList.add('init');
  slides.style.transition = 'none';
  if (typeof start === 'number') go(0); else go(start.i, start.hl);
  requestAnimationFrame(() => requestAnimationFrame(() => { slides.style.transition = ''; app.classList.remove('init'); }));
  addEventListener('resize', () => go(cur));
  document.fonts?.ready.then(fit);
  addEventListener('hashchange', () => { const s = fromHash(); if (typeof s !== 'number') go(s.i, s.hl); });

  prev.addEventListener('click', () => go(cur - 1));
  next.addEventListener('click', () => go(cur + 1));
  nodes.forEach((n) => n.addEventListener('click', () => go(Number(n.dataset.i))));
  addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement).closest('input,textarea')) return;
    if (e.key === 'ArrowRight') go(cur + 1); else if (e.key === 'ArrowLeft') go(cur - 1);
    else if (e.key === 'Home') go(0); else if (e.key === 'End') go(N - 1);
  });

  // mobile: switch between stories / referentes
  items.forEach((s) => s.querySelectorAll<HTMLButtonElement>('.seg button').forEach((b) => b.addEventListener('click', () => {
    s.dataset.view = b.dataset.v; fit();
    s.querySelectorAll('.seg button').forEach((x) => x.classList.toggle('on', x === b));
  })));

  // tabs inside each era
  items.forEach((s) => s.querySelectorAll<HTMLButtonElement>('.tab').forEach((t) => t.addEventListener('click', () => {
    s.querySelectorAll('.tab').forEach((x) => x.classList.toggle('on', x === t));
    s.querySelectorAll('.sp').forEach((x) => x.classList.toggle('on', (x as HTMLElement).dataset.k === t.dataset.k));
    fit();
  })));

  // swipe
  let sx = 0, sy = 0;
  const vp = document.getElementById('viewport')!;
  vp.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
  vp.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
    if (Math.abs(dx) > 55 && Math.abs(dx) > Math.abs(dy) * 1.4) go(cur + (dx < 0 ? 1 : -1));
  }, { passive: true });
</script>
