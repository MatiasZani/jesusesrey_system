---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
const { title, description = `${site.name} en ${site.city}. ${site.tagline}.`, bare = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.city}`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a78b8" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:image" content="/og-image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{fullTitle}</title>
  </head>
  <body class:list={{ bare }}>
    <div id="progress"></div>
    <Header solid={bare} />
    <main><slot /></main>
    {!bare && <Footer />}
    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Aparicion escalonada entre hermanos .reveal
      document.querySelectorAll('.reveal').forEach((el) => {
        const sibs = el.parentElement ? [...el.parentElement.children].filter((c) => c.classList.contains('reveal')) : [];
        (el as HTMLElement).style.transitionDelay = `${Math.min(sibs.indexOf(el), 8) * 110}ms`;
      });
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { const t = e.target as HTMLElement; t.classList.add('in'); io.unobserve(t); setTimeout(() => { t.style.transitionDelay = ''; }, 1600); } }), { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      if (!reduce) {
        const bar = document.getElementById('progress')!;
        const par = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
        const lines = [...document.querySelectorAll<HTMLElement>('.line')];
        let tick = false;
        const update = () => {
          tick = false;
          const y = scrollY, max = document.documentElement.scrollHeight - innerHeight;
          bar.style.transform = `scaleX(${max > 0 ? y / max : 0})`;
          par.forEach((p) => { p.style.translate = `0 ${y * Number(p.dataset.parallax)}px`; });
          lines.forEach((l) => {
            const r = l.getBoundingClientRect();
            l.style.setProperty('--p', String(Math.max(0, Math.min(1, (innerHeight * 0.7 - r.top) / r.height))));
          });
        };
        addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(update); } }, { passive: true });
        update();
        document.querySelectorAll<HTMLElement>('.card').forEach((c) => {
          c.addEventListener('pointermove', (e) => {
            const r = c.getBoundingClientRect(), x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
            c.style.setProperty('--mx', `${x * 100}%`); c.style.setProperty('--my', `${y * 100}%`);
            if (c.tagName !== 'FORM') c.style.transform = `perspective(700px) rotateX(${(0.5 - y) * 6}deg) rotateY(${(x - 0.5) * 6}deg) translateY(-5px)`;
          });
          c.addEventListener('pointerleave', () => { c.style.transform = ''; });
        });
      }
    </script>
  </body>
</html>
